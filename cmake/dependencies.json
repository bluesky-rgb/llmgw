{
  "comment": "第三方依赖的唯一清单。cmake/Dependencies.cmake 与 tools/check_vulns.py 都只读这个文件。升级版本只改这里。有 url 的依赖按 URL 下载并校验 sha256；repo + tag 用于漏洞查询。",
  "dependencies": {
    "googletest": {
      "repo": "https://github.com/google/googletest.git",
      "tag": "v1.18.0",
      "license": "BSD-3-Clause",
      "used_by": "tests",
      "header_only": false
    },
    "nlohmann_json": {
      "repo": "https://github.com/nlohmann/json.git",
      "tag": "v3.12.0",
      "license": "MIT",
      "used_by": "config（读取配置文件）、server（错误响应体、模型列表）、测试、prototype",
      "header_only": true
    },
    "cpp_httplib": {
      "repo": "https://github.com/yhirose/cpp-httplib.git",
      "tag": "v0.67.0",
      "license": "MIT",
      "used_by": "prototype",
      "header_only": true
    },
    "boost": {
      "repo": "https://github.com/boostorg/boost.git",
      "tag": "boost-1.92.0",
      "url": "https://github.com/boostorg/boost/releases/download/boost-1.92.0/boost-1.92.0-cmake.tar.xz",
      "sha256": "9bed76128d4e46755dbe818487788c6fceb6f72b378f4daa49b7e1e600d9088d",
      "license": "BSL-1.0",
      "used_by": "core（Task<T>，只用 asio::awaitable）、spike；之后用于 server、upstream",
      "header_only": false,
      "libraries": [
        "asio",
        "beast"
      ]
    },
    "tl_expected": {
      "repo": "https://github.com/TartanLlama/expected.git",
      "tag": "v1.3.1",
      "license": "CC0-1.0",
      "used_by": "core（Result<T>，见 ADR-007）",
      "header_only": true
    },
    "simdjson": {
      "repo": "https://github.com/simdjson/simdjson.git",
      "tag": "v5.2.0",
      "license": "Apache-2.0 OR MIT",
      "used_by": "server（热路径上从请求体中取 model、stream；任务 1.3 实测比 nlohmann 快 60–100 倍）",
      "header_only": false
    }
  }
}
